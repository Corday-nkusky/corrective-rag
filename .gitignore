.venv/
__pycache__/
*.pyc
.env

# 索引与 trace 是产物，可重建，不进 git
data/index/
data/traces/

# 评测集原始文件（corpus.jsonl 约 30MB，可随时从 HF 重新下载，不进 git；
# meta.json 保留以记录数据来源与统计）
data/eval/*.jsonl
data/eval/rgb_raw/

# 例外：手工构建的评测集是评测输入、不可重下，必须进 git（数字出处的原料）
!data/eval/router_eval.jsonl

# 模型缓存（默认在 C 盘用户目录，不落在仓库里）
.cache/
models/
