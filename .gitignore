.venv/
__pycache__/
*.pyc
.env

# 索引是产物，可重建，不进 git
data/index/

# trace 默认进 git：README/计划书里每个数字的唯一出处，且花了真钱不可重跑
# （全量 675K / 26 文件）。仅忽略日志、断点临时文件与冒烟等无长期价值的产物
data/traces/*.log
data/traces/*.done
data/traces/ab_progress_smoke.jsonl
data/traces/corrective_ab_20261013_152535.json

# 评测集原始文件（corpus.jsonl 约 30MB，可随时从 HF 重新下载，不进 git；
# meta.json 保留以记录数据来源与统计）
data/eval/*.jsonl
data/eval/rgb_raw/

# 例外：手工构建的评测集是评测输入、不可重下，必须进 git（数字出处的原料）
!data/eval/router_eval.jsonl

# 模型缓存（默认在 C 盘用户目录，不落在仓库里）
.cache/
models/

# 协作者/AI 助手的本地工作区（记忆、会话日志），属个人上下文，不进仓库
.workbuddy/
