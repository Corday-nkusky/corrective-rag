# 复制为 .env 后填写。.env 不进 git。
# HF_ENDPOINT 必填：本机直连 huggingface.co 不通（2026-10-12 实测超时）。
HF_ENDPOINT=https://hf-mirror.com

# DeepSeek API（OpenAI 兼容协议）。key 在 https://platform.deepseek.com 申请。
DEEPSEEK_API_KEY=sk-填你的
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 以下为可选覆盖，默认值见 src/corrective_rag/config.py
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# RERANKER_MODEL=BAAI/bge-reranker-base
# CHUNK_SIZE=400
# CHUNK_OVERLAP=60
# TOP_K_RETRIEVE=20
# TOP_K_FINAL=4
# MAX_ITERATIONS=3
