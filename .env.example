# 复制为 .env 后填写。.env 不进 git。
HF_ENDPOINT=https://hf-mirror.com

# 小米 MiMo API（OpenAI 兼容协议，按量付费）
# base_url / 模型名来自官方文档（mimo.mi.com/docs）；模型列表经 /v1/models 实测确认
# key 在 https://platform.xiaomimimo.com 申请；余额按量计费，注意成本
LLM_BASE_URL=https://api.xiaomimimo.com/v1
LLM_API_KEY=sk-填你的
LLM_MODEL=mimo-v2.6-flash

# 备选模型（需花钱对比时再换）：mimo-v2.5 / mimo-v2.5-pro / mimo-v2.6-pro
# 注意：mimo-v2.5 与 mimo-v2.5-pro 将于 2026-10-21 下线（官方公告）
# 换其他 OpenAI 兼容供应商（如 DeepSeek）只改这三行，代码不动：
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_API_KEY=sk-填你的
#   LLM_MODEL=deepseek-chat

# 以下为可选覆盖，默认值见 src/corrective_rag/config.py
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# RERANKER_MODEL=BAAI/bge-reranker-base
# CHUNK_SIZE=400
# CHUNK_OVERLAP=60
# TOP_K_RETRIEVE=20
# TOP_K_FINAL=4
# MAX_ITERATIONS=3
# 成本核算价目（元/百万 tokens，不填则按 cost.py 内置的 MiMo 官方价）：
# LLM_PRICE_IN=1.00
# LLM_PRICE_OUT=2.00
